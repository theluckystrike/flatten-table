{
 "slug": "flatten-table",
 "module": "flatten-table/src/flatten",
 "function": "flatten",
 "note": "args = [notes as [{path, frontmatter}] in base order, options {property, columns, keepEmpty, sort, filter, groupBy, maxSources}]; expected = fields to compare: valueColumn, columns, rows as [source path, item number, ...cells], sources, skippedSources, emptyNotes, groups as [{key, count}]. Only the fields present are compared.",
 "cases": [
  {
   "name": "forum 105425 example: two people give five role rows",
   "args": [
    [
     {
      "path": "People/Trump.md",
      "frontmatter": {
       "Roles": [
        {
         "Role": "President",
         "Start": "2025-01-20"
        },
        {
         "Role": "President",
         "Start": "2017-01-20",
         "End": "2021-01-20"
        }
       ]
      }
     },
     {
      "path": "People/Biden.md",
      "frontmatter": {
       "Roles": [
        {
         "Role": "Vice President",
         "Start": "2009-01-20",
         "End": "2013-01-20"
        },
        {
         "Role": "Vice President",
         "Start": "2013-01-20",
         "End": "2017-01-20"
        },
        {
         "Role": "President",
         "Start": "2021-01-20",
         "End": "2025-01-20"
        }
       ]
      }
     }
    ],
    {
     "property": "Roles"
    }
   ],
   "expected": {
    "columns": [
     "Role",
     "Start",
     "End"
    ],
    "rows": [
     [
      "People/Trump.md",
      1,
      "President",
      "2025-01-20",
      ""
     ],
     [
      "People/Trump.md",
      2,
      "President",
      "2017-01-20",
      "2021-01-20"
     ],
     [
      "People/Biden.md",
      1,
      "Vice President",
      "2009-01-20",
      "2013-01-20"
     ],
     [
      "People/Biden.md",
      2,
      "Vice President",
      "2013-01-20",
      "2017-01-20"
     ],
     [
      "People/Biden.md",
      3,
      "President",
      "2021-01-20",
      "2025-01-20"
     ]
    ],
    "sources": 2,
    "emptyNotes": 0
   }
  },
